{
  "name": "zoreva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:advisor": "node scripts/test-advisor-validate.mjs",
    "test:infinisynapse": "node scripts/test-infinisynapse.mjs",
